---
import BaseHead from '../components/BaseHead.astro';
import { env } from 'cloudflare:workers';
export const prerender = false;

type Article = {
	id: number;
	title: string;
	summary: string;
	source_url: string;
	cover_url: string;
	category: string;
	tags: string;
	published_at: string | null;
	click_count: number;
};

type ArticleDatabase = {
	prepare(query: string): {
		bind(...values: string[]): {
			all(): Promise<{ results?: unknown[] }>;
		};
	};
};
const database = env.DB as unknown as ArticleDatabase;

let articles: Article[] = [];
let databaseAvailable = true;

try {
	const result = await database
	.prepare(
		`SELECT id, title, summary, source_url, cover_url, category, tags, published_at, click_count
		FROM articles
		WHERE status = ?
		ORDER BY featured_score DESC, click_count DESC, created_at DESC
		LIMIT 24`,
	)
	.bind('published')
	.all();

	articles = (result.results ?? []) as Article[];
} catch (error) {
	databaseAvailable = false;

	const errorMessage = error instanceof Error
		? `${error.name}: ${error.message}`
		: String(error);

	console.error(`读取文章目录失败: ${errorMessage}`);
}
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title="文章导航" description="发现值得阅读的公众号文章" />
	</head>
	<body>
		<header class="site-header">
			<a class="brand" href="/">文章导航</a>
			<span>发现 · 分类 · 阅读</span>
		</header>

		<main>
			<section class="hero">
				<p class="eyebrow">ARTICLE HUB</p>
				<h1>把值得读的文章，<br />整理在一起。</h1>
				<p class="intro">按主题发现公众号文章。点击卡片后，将在原公众号页面阅读全文。</p>
			</section>

			<section class="article-section" aria-labelledby="latest-heading">
				<div class="section-heading">
					<div>
						<p class="eyebrow">LATEST</p>
						<h2 id="latest-heading">最新收录</h2>
					</div>
					<span>{articles.length} 篇文章</span>
				</div>

				{
					!databaseAvailable ? (
						<p class="notice">文章目录暂时无法读取，请稍后再试。</p>
					) : articles.length === 0 ? (
						<p class="notice">还没有文章。请先在 D1 的 articles 表中录入内容。</p>
					) : (
						<div class="article-grid">
							{
								articles.map((article) => (
									<article class="article-card">
										<a href={article.source_url} target="_blank" rel="noreferrer">
											{
												article.cover_url ? (
													<img src={article.cover_url} alt="" loading="lazy" />
												) : (
													<div class="cover-placeholder" aria-hidden="true">
														<span>{article.category.slice(0, 1)}</span>
													</div>
												)
											}
											<div class="card-content">
												<p class="category">{article.category}</p>
												<h3>{article.title}</h3>
												{article.summary && <p class="summary">{article.summary}</p>}
												<div class="meta">
													<span>{article.tags || '未添加标签'}</span>
													{article.click_count > 0 && <span>{article.click_count} 次浏览</span>}
												</div>
											</div>
										</a>
									</article>
								))
							}
						</div>
					)
				}
			</section>
		</main>

		<footer>文章正文及版权归原公众号作者所有。</footer>
	</body>
</html>

<style>
	:global(*) {
		box-sizing: border-box;
	}

	:global(body) {
		margin: 0;
		color: #172019;
		background: #f7f6f1;
		font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Microsoft YaHei', sans-serif;
	}

	.site-header,
	main,
	footer {
		width: min(1120px, calc(100% - 40px));
		margin: 0 auto;
	}

	.site-header {
		display: flex;
		justify-content: space-between;
		align-items: center;
		padding: 24px 0;
		font-size: 14px;
		color: #647067;
	}

	.brand {
		color: #172019;
		font-size: 18px;
		font-weight: 700;
		text-decoration: none;
	}

	.hero {
		padding: 80px 0 72px;
		border-bottom: 1px solid #d9ddd4;
	}

	.eyebrow {
		margin: 0 0 12px;
		color: #687768;
		font-size: 12px;
		font-weight: 700;
		letter-spacing: 0.12em;
	}

	h1,
	h2,
	h3,
	p {
		margin-top: 0;
	}

	h1 {
		max-width: 760px;
		margin-bottom: 24px;
		font-size: clamp(40px, 7vw, 76px);
		line-height: 1.08;
		letter-spacing: -0.06em;
	}

	.intro {
		max-width: 500px;
		margin: 0;
		color: #566158;
		font-size: 17px;
		line-height: 1.8;
	}

	.article-section {
		padding: 52px 0 80px;
	}

	.section-heading {
		display: flex;
		justify-content: space-between;
		align-items: end;
		margin-bottom: 28px;
	}

	h2 {
		margin: 0;
		font-size: 28px;
	}

	.section-heading > span {
		color: #748078;
		font-size: 14px;
	}

	.article-grid {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 20px;
	}

	.article-card {
		overflow: hidden;
		background: #ffffff;
		border: 1px solid #e2e5df;
		border-radius: 16px;
		transition: transform 160ms ease, box-shadow 160ms ease;
	}

	.article-card:hover {
		transform: translateY(-4px);
		box-shadow: 0 12px 32px rgb(23 32 25 / 10%);
	}

	.article-card a {
		display: block;
		height: 100%;
		color: inherit;
		text-decoration: none;
	}

	.article-card img,
	.cover-placeholder {
		display: block;
		width: 100%;
		aspect-ratio: 1.6 / 1;
		object-fit: cover;
	}

	.cover-placeholder {
		display: grid;
		place-items: center;
		background: linear-gradient(135deg, #dfe9d5, #adc5a8);
		color: #36533a;
		font-size: 52px;
		font-weight: 700;
	}

	.card-content {
		padding: 20px;
	}

	.category {
		margin-bottom: 10px;
		color: #4f7455;
		font-size: 13px;
		font-weight: 700;
	}

	h3 {
		margin-bottom: 12px;
		font-size: 20px;
		line-height: 1.45;
	}

	.summary {
		display: -webkit-box;
		overflow: hidden;
		margin-bottom: 18px;
		color: #657067;
		line-height: 1.7;
		-webkit-box-orient: vertical;
		-webkit-line-clamp: 2;
	}

	.meta {
		display: flex;
		gap: 12px;
		color: #899188;
		font-size: 12px;
	}

	.notice {
		padding: 32px;
		color: #687768;
		background: #eef1ea;
		border-radius: 12px;
		text-align: center;
	}

	footer {
		padding: 28px 0 40px;
		color: #7b857c;
		border-top: 1px solid #d9ddd4;
		font-size: 13px;
	}

	@media (max-width: 760px) {
		.article-grid {
			grid-template-columns: 1fr;
		}

		.hero {
			padding: 52px 0;
		}

		.site-header > span {
			display: none;
		}
	}
</style>
